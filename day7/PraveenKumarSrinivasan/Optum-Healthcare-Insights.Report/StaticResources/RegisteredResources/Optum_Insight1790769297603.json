{
  "name": "Optum Insight",
  "dataColors": [
    "#FF612B",
    "#002677",
    "#F9A667",
    "#095F87",
    "#73716A",
    "#B83C20",
    "#0C55B8",
    "#FFD1AB",
    "#3D3C38",
    "#989790"
  ],
  "background": "#FFFFFF",
  "foreground": "#3D3C38",
  "foregroundNeutralSecondary": "#73716A",
  "backgroundLight": "#F3F3F3",
  "backgroundNeutral": "#CECDCA",
  "tableAccent": "#FF612B",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FAF8F2"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FAF8F2"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E7E6E4"
              }
            },
            "radius": 6,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "fontSize": 11
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#73716A"
              }
            },
            "border": {
              "solid": {
                "color": "#E7E6E4"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#73716A"
              }
            },
            "fontSize": 9,
            "titleColor": {
              "solid": {
                "color": "#73716A"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E7E6E4"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#73716A"
              }
            },
            "fontSize": 9,
            "titleColor": {
              "solid": {
                "color": "#73716A"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E7E6E4"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "fontSize": 9,
            "position": "Top"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "fontSize": 9
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "fontSize": 26,
            "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#73716A"
              }
            },
            "fontSize": 10
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
