        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#73716A"
              }
            },
            "textSize": 9
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "altBackColor": {
              "solid": {
                "color": "#FAF8F2"
              }
            },
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#E7E6E4"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "altBackColor": {
              "solid": {
                "color": "#FAF8F2"
              }
            },
            "fontSize": 9
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFF8F6"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FBDED6"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "fontSize": 9,
            "labelPosition": "OutsideEnd"
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "labelPosition": "InsideCenter"
          }
        ],
        "totals": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#3D3C38"
              }
            },
            "fontSize": 9
          }
        ]
      }
    }
  },
  "secondaryBackground": "#FAF8F2",
  "foregroundNeutralTertiary": "#989790",
  "hyperlink": "#095F87",
  "visitedHyperlink": "#05344A",
  "good": "#066605",
  "neutral": "#FAAF00",
  "bad": "#D71515",
  "maximum": "#B83C20",
  "center": "#FAF8F2",
  "minimum": "#095F87",
  "null": "#CECDCA",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#000000"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#3D3C38"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#3D3C38"
    },
    "callout": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 26,
      "color": "#3D3C38"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 18,
      "color": "#000000"
    }
  }
}