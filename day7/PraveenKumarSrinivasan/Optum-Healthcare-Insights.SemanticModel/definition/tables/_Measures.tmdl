/// Home table for all report measures
table _Measures
	lineageTag: bba7c1c5-1c57-40f5-84e6-8d886b7591f2

	measure 'Total Claims' = SUM(FactClaims[ClaimCount])
		formatString: #,0
		displayFolder: Claims
		lineageTag: ca589ceb-f0e5-4f71-9fe4-cf21f2aeaeb7

	measure 'Billed Amount' = SUM(FactClaims[BilledAmount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		lineageTag: e398c7b9-c7f5-4d81-8fc0-d1816d8c378c

	measure 'Allowed Amount' = SUM(FactClaims[AllowedAmount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		lineageTag: a45ea92d-01bd-44a4-b861-7097f4e28d9d

	measure 'Paid Amount' = SUM(FactClaims[PaidAmount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		lineageTag: 4eb451bc-ea4b-4e9f-b783-9ff6200f82e5

	measure 'Avg Paid per Claim' = DIVIDE([Paid Amount], [Total Claims])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		lineageTag: 8955221f-d9c2-42b1-9e95-1dd119a5edbb

	measure 'Allowed to Billed %' = DIVIDE([Allowed Amount], [Billed Amount])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Claims
		lineageTag: 97e77daa-b24e-42f3-8653-c9d7e50c4aa2

	measure 'Paid to Allowed %' = DIVIDE([Paid Amount], [Allowed Amount])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Claims
		lineageTag: a26a5b6c-514c-4a6b-8e95-6ba16aa68933

	measure 'Unique Members' = DISTINCTCOUNT(FactClaims[MemberKey])
		formatString: #,0
		displayFolder: Members
		lineageTag: 5709f68e-c31f-43e0-abfa-48fa91ad4ba0

	measure 'Member Months' = SUM(FactClaims[MemberMonths])
		formatString: #,0
		displayFolder: Members
		lineageTag: 4d817033-719e-4f4e-8375-937a0220fd87

	/// Paid per member per month. MemberMonths is 1 per claim in the source data.
	measure 'Paid PMPM' = DIVIDE([Paid Amount], [Member Months])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Members
		lineageTag: c923980f-62d3-412c-a181-e6e8e0158a4f

	measure 'Claims per 1K Members' = DIVIDE([Total Claims], [Unique Members]) * 1000
		formatString: #,0
		displayFolder: Members
		lineageTag: 75490ccc-11a6-4acf-bb2a-e81bbf08bb38

	measure 'Avg Member Age' = AVERAGEX(CALCULATETABLE(VALUES(DimMember[MemberKey]), FactClaims), CALCULATE(MAX(DimMember[Age])))
		formatString: 0.0
		displayFolder: Members
		lineageTag: 546a49e1-92a5-470d-8e71-1292050045f4

	measure Revenue = SUM(FactRevenue[RevenueAmount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Financial
		lineageTag: 7e8e0e37-9ed7-4931-bf4e-a677bb457af1

	/// Paid claims divided by premium revenue
	measure 'Medical Loss Ratio' = DIVIDE([Paid Amount], [Revenue])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Financial
		lineageTag: fb6f4421-857b-4a35-ac36-761b5ae2142d

	measure 'Operating Margin' = [Revenue] - [Paid Amount]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Financial
		lineageTag: ba6d5b50-5103-467c-a33d-1a8e344e33b8

	measure 'Margin %' = DIVIDE([Operating Margin], [Revenue])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Financial
		lineageTag: 06f4421d-830e-4c5a-85ef-a9107ab03a65

	measure 'Revenue PY' = CALCULATE([Revenue], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: 07f74597-2d84-4a2a-bb92-14dff7ce0395

	measure 'Paid Amount PY' = CALCULATE([Paid Amount], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: 8b217bfa-148a-497b-9455-c7d44eb5d917

	measure 'Total Claims PY' = CALCULATE([Total Claims], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: 43301cc0-fb89-47df-8ffb-7214b775f2b1

	/// YoY % for the selected year; when several years are in context, uses the latest year.
	measure 'Revenue YoY %' =
			VAR _latest = MAX(DimDate[Year])
			VAR _calc = VAR py = [Revenue PY] RETURN IF(NOT ISBLANK(py), DIVIDE([Revenue] - py, py))
			RETURN IF(HASONEVALUE(DimDate[Year]), _calc, CALCULATE(VAR py = [Revenue PY] RETURN IF(NOT ISBLANK(py), DIVIDE([Revenue] - py, py)), DimDate[Year] = _latest))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: 64791260-15f6-435f-b2af-9b4236f4b6c6

	/// YoY % for the selected year; when several years are in context, uses the latest year.
	measure 'Paid Amount YoY %' =
			VAR _yoy = VAR py = [Paid Amount PY] RETURN IF(NOT ISBLANK(py), DIVIDE([Paid Amount] - py, py))
			VAR _latest = MAX(DimDate[Year])
			RETURN IF(HASONEVALUE(DimDate[Year]), _yoy, CALCULATE(VAR py = [Paid Amount PY] RETURN IF(NOT ISBLANK(py), DIVIDE([Paid Amount] - py, py)), DimDate[Year] = _latest))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: 392bd275-1e9b-44b7-b43c-bef6568e9adf

	/// YoY % for the selected year; when several years are in context, uses the latest year.
	measure 'Total Claims YoY %' =
			VAR _latest = MAX(DimDate[Year])
			VAR _calc = VAR py = [Total Claims PY] RETURN IF(NOT ISBLANK(py), DIVIDE([Total Claims] - py, py))
			RETURN IF(HASONEVALUE(DimDate[Year]), _calc, CALCULATE(VAR py = [Total Claims PY] RETURN IF(NOT ISBLANK(py), DIVIDE([Total Claims] - py, py)), DimDate[Year] = _latest))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: c3e15c41-fd16-4d06-8c9d-9762e3319de4

	measure 'Out of Network Paid' = CALCULATE([Paid Amount], DimProvider[NetworkStatus] = "Out of Network")
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Network
		lineageTag: b9886f36-578c-4840-ada5-e81f47538aec

	measure 'OON Paid %' = DIVIDE([Out of Network Paid], [Paid Amount])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Network
		lineageTag: 6246a28c-8dbc-41da-acdc-1fe07fa38dbd

	measure 'Provider Count' = DISTINCTCOUNT(FactClaims[ProviderKey])
		formatString: #,0
		displayFolder: Network
		lineageTag: a0e6301c-0a5c-460f-adcd-a9eeea36ff6b

	measure 'Provider Detail Title' = "Provider Detail: " & SELECTEDVALUE(DimProvider[ProviderName], "Multiple providers") & " (" & SELECTEDVALUE(DimProvider[Specialty], "-") & ", " & SELECTEDVALUE(DimProvider[NetworkStatus], "-") & ")"
		displayFolder: UI
		lineageTag: 5b4f06de-40d5-4ae8-a80b-1c609821f19b

	/// Conditional-format color for MLR (target < 75%, alert >= 85%)
	measure 'MLR Color' = VAR m = [Medical Loss Ratio] RETURN SWITCH(TRUE(), ISBLANK(m), "#73716A", m >= 0.85, "#D71515", m >= 0.75, "#B83C20", "#066605")
		displayFolder: UI
		lineageTag: f168ed33-2c80-43be-b4d6-51b33496b4bd

	/// Rising cost = red, falling = green
	measure 'YoY Color Paid' = VAR y = [Paid Amount YoY %] RETURN SWITCH(TRUE(), ISBLANK(y), "#73716A", y > 0, "#D71515", "#066605")
		displayFolder: UI
		lineageTag: e444ba7e-f744-4831-ab40-7753e84dd6c7

	column Placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d4f4f6f1-f0fd-4433-8579-f0487ab1b0f0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Placeholder]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ROW("Placeholder", 0)

