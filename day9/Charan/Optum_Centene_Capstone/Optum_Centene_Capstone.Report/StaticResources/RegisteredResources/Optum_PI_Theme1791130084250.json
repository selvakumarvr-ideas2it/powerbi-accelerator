{
  "name": "Optum_PI_Theme",
  "dataColors": [
    "#FF612B",
    "#002677",
    "#0C55B8",
    "#F5B335",
    "#5A8FA8",
    "#C72C48",
    "#7A7A7A",
    "#2E9E6B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#6B7280",
  "backgroundLight": "#FAF8F2",
  "backgroundNeutral": "#E5E1D8",
  "tableAccent": "#FF612B",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E4DA"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 92,
            "position": "Outer",
            "preset": "Custom",
            "shadowBlur": 12,
            "shadowDistance": 2,
            "angle": 90
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 24,
            "color": {
              "solid": {
                "color": "#002677"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FAF8F2"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}