/// Home table for every report measure.
table _Measures
	lineageTag: 79e8c371-be47-4e95-a509-eb150197423b

	/// Pre-pay + post-pay savings identified by PI services.
	measure 'Total Savings' = SUM(fact_pi_measures[total_savings_amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Savings
		lineageTag: 7dafe59c-a4f1-4216-aa66-84be10ec0139

	/// Savings avoided before payment (claim edits, prepay review).
	measure 'Pre-Pay Savings' = SUM(fact_pi_measures[pre_pay_savings_amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Savings
		lineageTag: 89cf3afe-5225-4f66-b0c3-a79fefff06c3

	/// Overpayments recovered after payment.
	measure 'Post-Pay Savings' = SUM(fact_pi_measures[post_pay_savings_amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Savings
		lineageTag: 636173bc-729c-41eb-bec0-473aa6409860

	/// Share of total savings captured before payment (cost avoidance is cheaper than recovery).
	measure 'Pre-Pay Share %' = DIVIDE([Pre-Pay Savings], [Total Savings])
		formatString: 0.0%
		displayFolder: 1 Savings
		lineageTag: 574a8bce-28bc-4f5a-a1cb-2bf25208565b

	/// Total savings as a share of billed dollars.
	measure 'Savings Rate %' = DIVIDE([Total Savings], [Total Billed])
		formatString: 0.00%
		displayFolder: 1 Savings
		lineageTag: 1e40d8e6-fa28-479d-b545-cd17dc480153

	/// Total savings divided by claims processed.
	measure 'Savings per Processed Claim' = DIVIDE([Total Savings], [Claims Processed])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1 Savings
		lineageTag: cead0d10-75e6-4478-93d9-ab1a5792cdf8

	/// Calendar year-to-date savings.
	measure 'Savings YTD' = TOTALYTD([Total Savings], dim_date[full_date])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Savings
		lineageTag: 4a8a08c8-13f1-48d3-bce7-6970d2908295

	/// Provider billed amount.
	measure 'Total Billed' = SUM(fact_pi_measures[total_billed_amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Claims & Payments
		lineageTag: c021f450-d19b-4021-9da2-226581441033

	/// Amount paid on the claims.
	measure 'Total Paid' = SUM(fact_pi_measures[total_paid_amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Claims & Payments
		lineageTag: 8e36fa33-fb26-4a21-b07d-7c7848a6036a

	/// Paid / billed.
	measure 'Paid to Billed %' = DIVIDE([Total Paid], [Total Billed])
		formatString: 0.0%
		displayFolder: 2 Claims & Payments
		lineageTag: cab516d7-2f64-4076-9728-78a6b06ee30a

	/// Claims submitted (source column is named *_amount but holds whole-number claim counts).
	measure 'Claims Submitted' = SUM(fact_pi_measures[total_claims_submitted_amount])
		formatString: #,0
		displayFolder: 2 Claims & Payments
		lineageTag: fc7b96b5-2cb2-4f04-b393-0b9830440fca

	/// Claims that passed pre-payment edits.
	measure 'Claims Pre-Edit Allowed' = SUM(fact_pi_measures[total_claims_pre_edit_allowed_amount])
		formatString: #,0
		displayFolder: 2 Claims & Payments
		lineageTag: 2c30073b-e395-4154-b2b2-1cdc589dd66e

	/// Claims processed through adjudication.
	measure 'Claims Processed' = SUM(fact_pi_measures[total_claims_processed_amount])
		formatString: #,0
		displayFolder: 2 Claims & Payments
		lineageTag: b3997476-823b-486c-aa20-8ee3e9560a5f

	/// Share of submitted claims stopped by pre-payment edits.
	measure 'Pre-Edit Reduction %' = 1 - DIVIDE([Claims Pre-Edit Allowed], [Claims Submitted])
		formatString: 0.0%
		displayFolder: 2 Claims & Payments
		lineageTag: 616a22ea-4140-4a87-aa17-bb4811fd4d13

	/// Processed / submitted claims.
	measure 'Processing Yield %' = DIVIDE([Claims Processed], [Claims Submitted])
		formatString: 0.0%
		displayFolder: 2 Claims & Payments
		lineageTag: aa521c4c-bd65-4596-aeb7-2e961d66d6b7

	/// Simple average of the row-level true positive rate (rates are averaged, never summed).
	measure 'Avg True Positive Rate %' = DIVIDE(AVERAGE(fact_pi_measures[true_positive_rate_pct]), 100)
		formatString: 0.0%
		displayFolder: 3 Accuracy
		lineageTag: 95bb05ae-1e71-4b08-8b60-bb85925917d0

	/// True positive rate weighted by savings dollars - big findings count more.
	measure 'Savings-Weighted TPR %' =
			DIVIDE(
			    SUMX(fact_pi_measures, fact_pi_measures[true_positive_rate_pct] * fact_pi_measures[total_savings_amount]),
			    [Total Savings]
			) / 100
		formatString: 0.0%
		displayFolder: 3 Accuracy
		lineageTag: 8a04f704-fee2-4158-9b51-63c67f4422b6

	/// Savings for the same period last year.
	measure 'Total Savings PY' = CALCULATE([Total Savings], SAMEPERIODLASTYEAR(dim_date[full_date]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4 Time Intelligence
		lineageTag: 05771265-0be9-4c20-b4a1-c606936832b8

	/// Change vs same period last year (blank for 2023 - no prior year).
	measure 'Savings YoY %' =
			VAR Curr = [Total Savings]
			VAR Prev = [Total Savings PY]
			RETURN IF(NOT ISBLANK(Prev), DIVIDE(Curr - Prev, Prev))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: 6abba1d4-19eb-4fa4-9983-5f734f03e07a

	/// Latest year in the current selection vs the year before. Used on KPI cards.
	measure 'Latest Year YoY %' =
			VAR LastYear = YEAR(MAX(fact_pi_measures[period_date]))
			VAR Curr = CALCULATE([Total Savings], dim_date[year] = LastYear)
			VAR Prev = CALCULATE([Total Savings], dim_date[year] = LastYear - 1)
			RETURN IF(NOT ISBLANK(Prev), DIVIDE(Curr - Prev, Prev))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: ecfbc4a2-9a15-4d7a-aa5c-40f6ce02cb5a

	/// Rank of the provider by total savings within the current selection.
	measure 'Provider Savings Rank' =
			IF(
			    ISINSCOPE(dim_provider[provider_name]) && NOT ISBLANK([Total Savings]),
			    RANKX(ALLSELECTED(dim_provider), [Total Savings], , DESC, Dense)
			)
		formatString: 0
		displayFolder: 5 Provider
		lineageTag: 6b4d2e96-4af3-4f40-8c95-4c96beb6c432

	/// Distinct providers that have fact rows.
	measure 'Providers with Savings' = DISTINCTCOUNT(fact_pi_measures[provider_key])
		formatString: #,0
		displayFolder: 5 Provider
		lineageTag: 6c585ece-b021-46ba-b6f0-4821de24792c

	/// Rows in the fact table.
	measure 'Fact Row Count' = COUNTROWS(fact_pi_measures)
		formatString: #,0
		displayFolder: 6 Data Quality
		lineageTag: b397b925-d94d-48e6-be62-34d087fb5db3

	/// Fact rows whose employer_group_key was null in the source.
	measure 'Rows Without Employer Group' = CALCULATE([Fact Row Count], dim_employer_group[mapping_status] = "Not Assigned (null key)")
		formatString: #,0
		displayFolder: 6 Data Quality
		lineageTag: d2cdd2b6-0d33-4707-a9fb-f948c3df3ce2

	/// Fact rows pointing to employer group keys missing from the dimension.
	measure 'Rows With Orphan Employer Group' = CALCULATE([Fact Row Count], dim_employer_group[mapping_status] = "Orphan key (missing in dimension)")
		formatString: #,0
		displayFolder: 6 Data Quality
		lineageTag: 5c01c6cf-72f4-4afc-85e0-7e91b41dd350

	/// Total savings minus (pre-pay + post-pay). Must be 0.
	measure 'Savings Reconciliation Gap' = [Total Savings] - ([Pre-Pay Savings] + [Post-Pay Savings])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 6 Data Quality
		lineageTag: 8bdda37e-97f9-48d6-9453-8db3f7ccf4ab

	/// Dynamic header for the drill-through page.
	measure 'Provider Page Title' = "Provider Detail  |  " & SELECTEDVALUE(dim_provider[provider_name], "All providers - right-click a provider and choose Drill through")
		displayFolder: 7 Labels
		lineageTag: 9f58a9ba-67aa-4c84-8ba6-a8663ff5d187

	/// Footer text showing the period covered by the current selection.
	measure 'Data Range Label' = "Data: " & FORMAT(MIN(fact_pi_measures[period_date]), "mmm yyyy") & " - " & FORMAT(MAX(fact_pi_measures[period_date]), "mmm yyyy")
		displayFolder: 7 Labels
		lineageTag: d71b94d4-8554-4abb-9c32-c2e5f0cbee54

	/// Number of clients with PI activity in the current selection.
	measure 'Active Clients' = DISTINCTCOUNT(fact_pi_measures[client_key])
		formatString: #,0
		displayFolder: 8 Client
		lineageTag: 2812bbc4-2b30-44e3-906c-6984c1ba4ecc

	/// Client share of total savings within the current selection (sums to 100% across clients).
	measure 'Client Savings Share %' = DIVIDE([Total Savings], CALCULATE([Total Savings], ALLSELECTED(dim_client)))
		formatString: 0.0%
		displayFolder: 8 Client
		lineageTag: d316eee8-49c7-4611-bb31-fc7a18f1bc53

	/// Fact rows whose employer group belongs to a different client than the row (business-rule conflict). Must be 0.
	measure 'Rows With Employer Group Client Conflict' = COUNTROWS(FILTER(fact_pi_measures, VAR egClient = RELATED(dim_employer_group[eg_client_key]) RETURN NOT ISBLANK(egClient) && egClient <> fact_pi_measures[client_key]))
		formatString: #,0
		displayFolder: 6 Data Quality
		lineageTag: fd1ac3d2-a228-44b6-9aaa-e1d5d4b83dd6

	column Value
		dataType: string
		isHidden
		lineageTag: b8536567-6e99-4821-b68e-a11b201e3a89
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Value = text], {})
				in
				    Source

