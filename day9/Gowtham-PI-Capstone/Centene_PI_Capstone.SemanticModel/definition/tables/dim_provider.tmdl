/// Providers (SCD2 - Sunrise Rehabilitation re-registered as LLC on 2024-04-01). Drill-through key: provider_name.
table dim_provider
	lineageTag: cacabfa9-2449-4e5c-8d40-119d239d2173

	column provider_key
		dataType: int64
		isHidden
