	partition dim_provider = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_provider.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"provider_key", "provider_tin", "provider_npi", "provider_name", "provider_type", "provider_state", "is_current"}),
				    NullFixed = Table.ReplaceValue(Selected, "null", null, Replacer.ReplaceValue, Table.ColumnNames(Selected)),
				    Typed = Table.TransformColumnTypes(NullFixed, {{"provider_key", Int64.Type}, {"provider_tin", type text}, {"provider_npi", type text}, {"provider_name", type text}, {"provider_type", type text}, {"provider_state", type text}, {"is_current", type logical}}, "en-US")
				in
				    Typed

