{
  "name": "Centene Payment Integrity",
  "dataColors": [
    "#00598C",
    "#00A0A4",
    "#F58220",
    "#5C2F92",
    "#CB187D",
    "#2C8641",
    "#AAC932",
    "#262768",
    "#007E7A",
    "#58595B"
  ],
  "foreground": "#333333",
  "foregroundNeutralSecondary": "#58595B",
  "foregroundNeutralTertiary": "#B6B6B6",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F4F4",
  "backgroundNeutral": "#DCDDDE",
  "tableAccent": "#00598C",
  "good": "#2C8641",
  "neutral": "#F58220",
  "bad": "#A94442",
  "maximum": "#00598C",
  "center": "#DFF7F7",
  "minimum": "#FFFFFF",
  "hyperlink": "#006DC1",
  "visitedHyperlink": "#5C2F92",
  "textClasses": {
    "title": {
      "fontFace": "'Roboto Slab', Georgia, serif",
      "fontSize": 14,
      "color": "#003356"
    },
    "header": {
      "fontFace": "'Roboto Medium', 'Segoe UI Semibold', sans-serif",
      "fontSize": 12,
      "color": "#003356"
    },
    "callout": {
      "fontFace": "'Roboto Light', 'Segoe UI Light', sans-serif",
      "fontSize": 26,
      "color": "#00598C"
    },
    "label": {
      "fontFace": "Roboto, 'Segoe UI', sans-serif",
      "fontSize": 10,
      "color": "#58595B"
    },
    "largeTitle": {
      "fontFace": "'Roboto Slab', Georgia, serif",
      "fontSize": 18,
      "color": "#00598C"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F4"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F4"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCDDDE"
              }
            },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#003356"
              }
            },
            "fontSize": 12,
            "fontFamily": "'Roboto Slab', Georgia, serif"
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#58595B"
              }
            }
          }
        ],
        "tooltip": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#003356"
              }
            },
            "titleFontColor": {
              "solid": {
                "color": "#DFF7F7"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "actionFontColor": {
              "solid": {
                "color": "#00A0A4"
              }
            },
            "fontFamily": "Roboto, 'Segoe UI', sans-serif",
            "fontSize": 10,
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#00598C"
              }
            },
            "fontSize": 24
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#58595B"
              }
            },
            "fontSize": 10
          }
        ],
        "accentBar": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#00A0A4"
              }
            },
            "width": 4
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontColor": {
              "solid": {
                "color": "#00598C"
              }
            }
          }
        ],
        "accentBar": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#00A0A4"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#003356"
              }
            },
            "fontFamily": "'Roboto Medium', 'Segoe UI Semibold', sans-serif"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#00598C"
              }
            }
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#E5F5FF"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#00598C"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#003356"
              }
            }
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#E5F5FF"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}